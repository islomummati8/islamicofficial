{
  "hosting": {
    "site": "islamicofficial-books",
    "public": "dist/books",
    "predeploy": [
      "node scripts/build-books-sitemap.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
