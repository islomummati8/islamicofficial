rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'islomummati8@gmail.com';
    }

    match /premiumCodes/{code} {
      allow create: if isAdmin();
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.redeemedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /articles/{article} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
    }
    match /books/{book} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /duas/{dua} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /userStats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /newsletterSubscribers/{subscriber} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if isAdmin();
    }
    match /articles/{article}/comments/{comment} {
      allow read: if true;
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if isAdmin();
    }
    match /articles/{article}/likes/{like} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
